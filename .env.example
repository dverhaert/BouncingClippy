# Azure AI Foundry Configuration for Semantic Kernel
# Copy this file to .env and fill in your actual values

# Your Azure AI Foundry endpoint URL (without /inference suffix)
# Example: https://your-project.eastus.services.ai.azure.com
AZURE_AI_FOUNDRY_ENDPOINT=https://resource.services.ai.azure.com/models
AZURE_AI_FOUNDRY_MODEL=gpt-5.4-1 # Any model is fine here, make sure it matches the model you use from foundry
FLASK_DEBUG=False
